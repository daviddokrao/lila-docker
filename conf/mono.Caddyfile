:8080

handle_errors 502 {
	root * /static/errors
	rewrite * /502.html
	file_server
}

# HungKings — asset ĐÃ BĂM HASH phải cache dài. Image mono cố ý chạy Play ở Dev-mode
# (xem memory image-chay-play-dev-mode), mà ở Dev-mode Play phục vụ /assets qua
# `controllers.ExternalAssets` và nó gắn cứng `Cache-Control: max-age=3600`. Hệ quả đo
# được bằng Lighthouse: mỗi lượt quay lại sau 1 giờ tải lại ~256 KiB font + JS + CSS
# vốn KHÔNG BAO GIỜ đổi nội dung. Sửa ở tầng Caddy trong chính image này là chỗ rẻ nhất
# (0 dòng Scala, không đụng hành vi Play).
#
# CHỈ khai những tiền tố mà tên tệp CÓ hash/phiên bản — đặt `immutable` nhầm lên một
# đường không băm hash là khoá người dùng vào bản cũ suốt một năm:
#   /assets/hashed/*    -> vd lichess.2a2cb52f.woff2
#   /assets/compiled/*  -> vd site.APZAY2M6.js, i18n/site.vi-VN.ca24f1d1228d.js
#   /assets/css/*       -> vd site.e85b3ded.css
#   /assets/_<ver>/*    -> tiền tố phiên bản asset, đổi mỗi lần build
# CỐ Ý bỏ ngoài: /assets/logo/*, /assets/apple-touch-icon.png, manifest.json… (tên cố định).
@immutableAssets {
	path /assets/hashed/* /assets/compiled/* /assets/css/* /assets/_*
}
# Dau ">" = "deferred set": ghi DE header cua upstream luc ghi response. Khong co no
# thi Caddy CONG THEM mot dong Cache-Control nua, va response ra ngoai mang CA HAI
# ("public, max-age=31536000, immutable" VA "max-age=3600") — da do that tren live.
header @immutableAssets >Cache-Control "public, max-age=31536000, immutable"

@websockets {
	header Connection *Upgrade*
	header Upgrade websocket
}

# GIẢI CỜ 2 PHÁI (arena) same-origin tại hungkings.com/giai-app/* — 18/08.
#
# VÌ SAO KHÔNG đi qua Main.streamProxy như /hlv-app, /diem-app, /realchess: arena sống bằng
# WebSocket (thế cờ, đồng hồ vòng, chat). Hai rào chặn, cả hai đều chí mạng:
#   1. streamProxy dùng Play WS client `.stream()` — đó là HTTP, không nâng cấp được
#      `Connection: Upgrade`.
#   2. Kể cả vá được Play thì matcher @websockets NGAY TRÊN vẫn bắt MỌI request mang
#      `Upgrade: websocket` và ném sang lila-ws :9664 TRƯỚC khi tới Play — arena sẽ bắt tay
#      nhầm với lila-ws rồi chết câm.
# Nên arena phải được chặn ngay tại tầng Caddy này, ĐẶT TRƯỚC khối bắt-tất-cả bên dưới.
#
# BẮT BUỘC dùng `handle`, KHÔNG được để `reverse_proxy` trần như trước: `handle` chỉ loại
# trừ lẫn nhau GIỮA CÁC `handle`. Một directive `reverse_proxy` trần nằm ngoài mọi handle vẫn
# tiếp tục khớp request đã được handle ở trên — nên khối bắt-tất-cả cũ buộc phải bọc vào
# `handle` thì việc loại trừ mới thật sự xảy ra.
#
# `handle_path` (khác `handle`) CẮT BỎ tiền tố trước khi chuyển đi, nên arena vẫn thấy đường
# `/`, `/app.js`, `/api/toi`, `/ws` y như lúc chạy ở gốc; nó chỉ cần `X-Base-Path` để biết
# phải PHÁT RA URL có tiền tố (đúng quy ước coach/points đang dùng).
#
# Đích đọc từ env để đổi được mà không dựng lại image (Caddyfile bake trong image).
redir /giai-app /giai-app/
handle_path /giai-app/* {
	reverse_proxy {$LILA_ARENA_UPSTREAM:hungkings-arena-web:8092} {
		header_up X-Base-Path /giai-app
	}
}

handle {
	reverse_proxy @websockets :9664 {
		header_up Origin {$LILA_URL}
	}

	reverse_proxy :9663 {
		header_up Host {$LILA_DOMAIN}
		header_up Origin {$LILA_URL}
	}
}
